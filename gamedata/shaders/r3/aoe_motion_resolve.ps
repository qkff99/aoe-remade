// Private motion input for both DLSS and FSR. Material colour/SSS buffers are untouched.
Texture2D<float4> aoe_material_motion;
Texture2D<float> aoe_depth;
cbuffer AOE_MotionResolve : register(b0)
{
    float4x4 aoe_reproject;     // current clip -> previous clip, both with their raster jitter
    float4x4 aoe_reproject_sky; // same, rotation only
    float4 aoe_resolve_jitter; // current-minus-previous raster UV offset, reset, unused
};

struct AOE_Motion
{
    float2 velocity : SV_Target0;
    float reactive : SV_Target1;
};

AOE_Motion main(float4 position : SV_Position, float2 uv : TEXCOORD0)
{
    AOE_Motion result;
    int2 pixel = int2(position.xy);
    float4 material = aoe_material_motion.Load(int3(pixel, 0));
    float depth = aoe_depth.Load(int3(pixel, 0));
    // Colour-blended draws lerp into this target by alpha: .w is coverage, .z the valid share.
    if (material.w > 0.004)
    {
        float2 velocity = material.xy / material.w;
        result.velocity = all(isfinite(velocity)) ? velocity : 0;
        result.reactive = 0.9 * (1 - saturate(material.z / material.w));
        return result;
    }
    float4 clip = float4(uv * float2(2, -2) + float2(-1, 1), depth, 1);
    // The sky has rotation history, without finite-distance camera translation.
    float4 previous = mul(depth >= 0.999999 ? aoe_reproject_sky : aoe_reproject, clip);
    float2 previous_uv = previous.xy / max(previous.w, 1e-6) * float2(0.5, -0.5) + 0.5;
    result.velocity = previous.w > 0.00001 ? uv - previous_uv - aoe_resolve_jitter.xy : 0;
    // Untracked/deformed coverage must not reuse an unrelated object history.
    result.reactive = aoe_resolve_jitter.z > 0.5 ? 0.9 : 0;
    return result;
}
